local function addSpot(part, range, angle, brightness)
	return new("SpotLight", {
		Face = Enum.NormalId.Front,
		Range = range,
		Angle = angle,
		Brightness = brightness,
		Color = Color3.fromRGB(255, 244, 220),
		Shadows = false,
		Enabled = false,
	}, part)
end

local function addSmoke(part, direction, big)
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/smoke_main.dds"
	e.Color = ColorSequence.new(Color3.fromRGB(200, 200, 205))
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, big and 0.5 or 0.6),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, big and 1.5 or 0.3),
		NumberSequenceKeypoint.new(1, big and 5 or 1.6),
	})
	e.Lifetime = NumberRange.new(0.5, big and 1.1 or 0.9)
	e.Speed = NumberRange.new(2, big and 7 or 6)
	e.SpreadAngle = Vector2.new(big and 25 or 8, big and 25 or 8)
	e.Rate = 0
	e.EmissionDirection = direction
	e.Drag = 1.5
	e.Acceleration = Vector3.new(0, 1.5, 0)
	e.Rotation = NumberRange.new(0, 360)
	e.Parent = part
	return e
end

local function addPlate(part, face)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(343, 100)
	gui.LightInfluence = 0.4
	gui.AlwaysOnTop = false
	gui.Parent = part
	new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Text = CFG.PLATE_TEXT .. "  " .. CFG.PLATE_REGION,
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		TextColor3 = Color3.fromRGB(20, 20, 24),
	}, gui)
end

local function setEmissive(part, on, colorOn, colorOff)
	if on then
		part.Material = Enum.Material.Neon
		part.Color = colorOn
	else
		part.Material = Enum.Material.SmoothPlastic
		part.Color = colorOff
	end
end

