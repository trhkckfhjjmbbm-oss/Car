local SIT_ANIM_R15 = "rbxassetid://2506281703"
local SIT_ANIM_R6 = "rbxassetid://178130996"

local function playSit(hum)
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = hum.RigType == Enum.HumanoidRigType.R15 and SIT_ANIM_R15 or SIT_ANIM_R6
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	if ok and track then
		track.Priority = Enum.AnimationPriority.Action
		track.Looped = true
		track:Play(0.15)
		S.sitTrack = track
	end
end

local function computeSpawnCF(distance)
	local ch = player.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return CFrame.new(0, 10, 0)
	end
	local look = hrp.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = flat.Magnitude > 0.05 and flat.Unit or Vector3.new(0, 0, -1)
	local pos = hrp.Position + flat * distance

	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = { ch, CAR and CAR.model }
	pcall(function()
		rp.RespectCanCollide = true
	end)
	local res = Workspace:Raycast(pos + Vector3.new(0, 60, 0), Vector3.new(0, -300, 0), rp)
	local y = res and (res.Position.Y + CFG.SPAWN_LIFT) or hrp.Position.Y
	local p = Vector3.new(pos.X, y, pos.Z)
	return CFrame.lookAt(p, p + flat)
end

-- Свободное место рядом с машиной: слева, справа, сзади, на крыше
local function findExitCFrame(carCF, ch)
	local offsets = {
		Vector3.new(-6.6, 1.0, 0.2),
		Vector3.new(6.6, 1.0, 0.2),
		Vector3.new(-6.6, 1.0, 6),
		Vector3.new(6.6, 1.0, 6),
		Vector3.new(0, 6.5, 0.5),
	}
	local op = OverlapParams.new()
	op.FilterType = Enum.RaycastFilterType.Exclude
	op.FilterDescendantsInstances = { CAR.model, ch }

	local look = carCF.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = flat.Magnitude > 0.05 and flat.Unit or Vector3.new(0, 0, -1)

	for _, off in ipairs(offsets) do
		local pos = carCF:PointToWorldSpace(off)
		local free = true
		for _, p in ipairs(Workspace:GetPartBoundsInBox(CFrame.new(pos), Vector3.new(2.8, 5, 2.8), op)) do
			if p.CanCollide then
				free = false
				break
			end
		end
		if free then
			return CFrame.lookAt(pos, pos + flat)
		end
	end
	local pos = carCF:PointToWorldSpace(offsets[#offsets])
	return CFrame.lookAt(pos, pos + flat)
end

-- После выхода персонаж не сталкивается с машиной (она ещё едет по инерции)
local function noCollideWithCar(ch)
	local list = {}
	for _, part in ipairs(ch:GetDescendants()) do
		if part:IsA("BasePart") then
			for _, carPart in ipairs({ CAR.chassis, CAR.cabin }) do
				local nc = Instance.new("NoCollisionConstraint")
				nc.Part0 = part
				nc.Part1 = carPart
				nc.Parent = part
				table.insert(list, nc)
			end
		end
	end
	task.delay(CFG.EXIT_NOCOLLIDE_TIME, function()
		for _, nc in ipairs(list) do
			nc:Destroy()
		end
	end)
end

enterCar = function()
	if S.driving or not CAR or not CAR.chassis.Parent then
		return
	end
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then
		return
	end
	if (root.Position - CAR.chassis.Position).Magnitude > CFG.ENTER_DISTANCE then
		return
	end

	local sitH = hum.RigType == Enum.HumanoidRigType.R15 and CFG.SIT_HEIGHT_R15 or CFG.SIT_HEIGHT_R6
	local sitCF = CFrame.new(CFG.SEAT_X, CFG.SEAT_TOP_Y + sitH, CFG.SEAT_Z)

	S.character, S.humanoid, S.root = ch, hum, root
	S.savedAutoRotate = hum.AutoRotate

	-- Привязка персонажа к сиденью одним Weld: общий assembly, без столкновений
	ch:PivotTo(CAR.chassis.CFrame * sitCF)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	local w = Instance.new("Weld")
	w.Name = "DriverWeld"
	w.Part0 = CAR.chassis
	w.Part1 = root
	w.C0 = sitCF
	w.Parent = CAR.chassis
	S.seatWeld = w

	-- PlatformStand: персонаж не может прыгнуть и вылететь из машины
	hum.PlatformStand = true
	hum.AutoRotate = false
	ContextActionService:BindActionAtPriority("CarNoJump", function()
		return Enum.ContextActionResult.Sink
	end, false, 3000, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)

	S.driving = true
	S.throttle, S.brake, S.steer = 0, 0, 0
	S.reverse, S.gear = false, 1
	S.lastKmh = -1

	S.diedConn = hum.Died:Connect(function()
		exitCar(true)
	end)
	playSit(hum)

	-- руки на руль
	S.arms = collectArms(ch, hum)
	S.armErr = false

	-- камера: сначала снаружи, смотрит за машину
	S.eyeLocal = Vector3.new(CFG.SEAT_X, CFG.SEAT_TOP_Y + CFG.EYE_HEIGHT, CFG.SEAT_Z - 0.1)
	S.lookYaw, S.lookPitch, S.zoom, S.lookTime = 0, 0, 1, os.clock()
	local look = CAR.chassis.CFrame.LookVector
	camDir = Vector3.new(look.X, 0, look.Z)
	camDir = camDir.Magnitude > 0.05 and camDir.Unit or Vector3.new(0, 0, -1)
	applyCameraMode()
	layoutHud(HUD)
end

exitCar = function(forced)
	if not S.driving then
		return
	end
	S.driving = false
	S.arms = nil
	S.touchHand = false
	ContextActionService:UnbindAction("CarNoJump")
	if S.diedConn then
		S.diedConn:Disconnect()
		S.diedConn = nil
	end
	if S.sitTrack then
		pcall(function()
			S.sitTrack:Stop(0.1)
		end)
		S.sitTrack = nil
	end
	if S.seatWeld then
		S.seatWeld:Destroy()
		S.seatWeld = nil
	end

	-- сброс управления камерой
	dragTouch = nil
	if dragMouse then
		dragMouse = false
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end

	local ch, hum, root = S.character, S.humanoid, S.root
	if not forced and ch and ch.Parent and hum and hum.Parent and root and root.Parent and CAR and CAR.chassis.Parent then
		local carVel = CAR.chassis.AssemblyLinearVelocity
		ch:PivotTo(findExitCFrame(CAR.chassis.CFrame, ch))
		root.AssemblyLinearVelocity = carVel * CFG.EXIT_VELOCITY_KEEP
		root.AssemblyAngularVelocity = Vector3.zero
		noCollideWithCar(ch)
		hum.PlatformStand = false
		hum.AutoRotate = S.savedAutoRotate
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	elseif hum and hum.Parent then
		hum.PlatformStand = false
		hum.AutoRotate = S.savedAutoRotate
	end
	applyCameraMode()
end

flipCar = function()
	if not CAR or not CAR.chassis.Parent then
		return
	end
	local c = CAR.chassis
	local p = c.Position + Vector3.new(0, 3.5, 0)
	local look = c.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = flat.Magnitude > 0.05 and flat.Unit or Vector3.new(0, 0, -1)
	c.CFrame = CFrame.lookAt(p, p + flat)
	c.AssemblyLinearVelocity = Vector3.zero
	c.AssemblyAngularVelocity = Vector3.zero
end

callCar = function()
	if S.driving then
		return
	end
	local cf = computeSpawnCF(CFG.CALL_DISTANCE)
	if not CAR or not CAR.chassis.Parent then
		CAR = buildCar(cf)
		rayParams.FilterDescendantsInstances = { CAR.model, player.Character }
		S.lastLights = -1
	else
		CAR.chassis.CFrame = cf
		CAR.chassis.AssemblyLinearVelocity = Vector3.zero
		CAR.chassis.AssemblyAngularVelocity = Vector3.zero
	end
end

cycleLights = function()
	S.lights = (S.lights + 1) % 3
end

toggleCamera = function()
	S.camMode = S.camMode == 1 and 2 or 1
	S.lookYaw, S.lookPitch, S.lookTime = 0, 0, os.clock()
	applyCameraMode()
end

---------------------------------------------------------------------------
-- ЗАПУСК
---------------------------------------------------------------------------
local function start()
	local ch = player.Character or player.CharacterAdded:Wait()
	ch:WaitForChild("HumanoidRootPart")

	CAR = buildCar(computeSpawnCF(CFG.SPAWN_DISTANCE))
	rayParams.FilterDescendantsInstances = { CAR.model, player.Character }
	HUD = buildHud()

	-- стандартные контроллеры (стик на телефоне, геймпад)
	task.spawn(function()
		local ok, mod = pcall(function()
			return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
		end)
		if ok and mod then
			local ok2, c = pcall(function()
				return mod:GetControls()
			end)
			if ok2 then
				controls = c
			end
		end
	end)

	-- физика и руки до шага симуляции
	local okSig, sig = pcall(function()
		return RunService.PreSimulation
	end)
	local stepSignal = (okSig and sig) or RunService.Stepped
	stepSignal:Connect(function(a, b)
		stepCar(b or a)
		if S.driving and S.arms then
			local ok, err = pcall(updateArms)
			if not ok and not S.armErr then
				S.armErr = true
				warn("CarController: руки не обновились:", err)
			end
		end
	end)
	RunService.RenderStepped:Connect(updateHud)
	RunService:BindToRenderStep("LocalCarCamera", Enum.RenderPriority.Camera.Value + 1, updateCamera)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local k = input.KeyCode
		if k == CFG.KEY_ENTER then
			enterCar()
		elseif k == CFG.KEY_EXIT then
			exitCar()
		elseif k == Enum.KeyCode.ButtonY then
			if S.driving then
				exitCar()
			else
				enterCar()
			end
		elseif k == CFG.KEY_LIGHTS or k == Enum.KeyCode.ButtonL1 then
			cycleLights()
		elseif k == CFG.KEY_FLIP then
			flipCar()
		elseif k == CFG.KEY_CALL then
			callCar()
		elseif k == CFG.KEY_CAMERA then
			toggleCamera()
		elseif k == CFG.KEY_TCS then
			S.tcsEnabled = not S.tcsEnabled
		end

		-- камера: палец (правее стика) или правая кнопка мыши
		if S.driving then
			if input.UserInputType == Enum.UserInputType.Touch then
				local cam = Workspace.CurrentCamera
				local width = cam and cam.ViewportSize.X or 800
				if input.Position.X > width * 0.4 and not dragTouch then
					dragTouch = input
				end
			elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
				dragMouse = true
				UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
			end
		end
	end)

	UserInputService.InputChanged:Connect(function(input, processed)
		if not S.driving then
			return
		end
		if input == dragTouch then
			lookInput(input.Delta.X, input.Delta.Y, CFG.CAM_TOUCH_SENS)
		elseif input.UserInputType == Enum.UserInputType.MouseMovement and dragMouse then
			lookInput(input.Delta.X, input.Delta.Y, CFG.CAM_MOUSE_SENS)
		elseif input.UserInputType == Enum.UserInputType.MouseWheel and not processed then
			S.zoom = math.clamp(S.zoom - input.Position.Z * 0.08, CFG.CAM_ZOOM_MIN, CFG.CAM_ZOOM_MAX)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input == dragTouch then
			dragTouch = nil
		end
		if input.UserInputType == Enum.UserInputType.MouseButton2 and dragMouse then
			dragMouse = false
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
	end)

	-- щипок двумя пальцами - приблизить / отдалить камеру
	local pinchBase = 1
	UserInputService.TouchPinch:Connect(function(_, scale, _, state, processed)
		if not S.driving or processed then
			return
		end
		if state == Enum.UserInputState.Begin then
			pinchBase = S.zoom
			dragTouch = nil
		else
			S.zoom = math.clamp(pinchBase / math.max(scale, 0.1), CFG.CAM_ZOOM_MIN, CFG.CAM_ZOOM_MAX)
		end
	end)

	player.CharacterAdded:Connect(function(newCh)
		if S.driving then
			exitCar(true)
		end
		S.character, S.humanoid, S.root = nil, nil, nil
		if CAR then
			rayParams.FilterDescendantsInstances = { CAR.model, newCh }
		end
	end)
	player.CharacterRemoving:Connect(function()
		if S.driving then
			exitCar(true)
		end
	end)
end

start()
