-- Размещение под размер экрана: кнопки сверху по центру, панель приборов масштабируется.
local function layoutHud(H)
	if not H then
		return
	end
	local vp = H.gui.AbsoluteSize
	if vp.X < 50 or vp.Y < 50 then
		return
	end

	H.panelScale.Scale = math.clamp(math.min(vp.X / 820, vp.Y / 450), 0.6, 1)

	local btns = H.touchButtons
	if not btns then
		return
	end
	local n = #btns
	local margin, gap = 8, 6
	local perRow = (vp.X < 560) and 3 or n
	local maxW = (perRow == n) and (vp.X * 0.62) or (vp.X - 2 * margin)
	local bw = math.clamp((maxW - (perRow - 1) * gap) / perRow, 50, 100)
	local bh = math.clamp(vp.Y * 0.115, 34, 46)
	for i, b in ipairs(btns) do
		local row = math.floor((i - 1) / perRow)
		local col = (i - 1) % perRow
		local inRow = math.min(perRow, n - row * perRow)
		local total = inRow * bw + (inRow - 1) * gap
		local x0 = (vp.X - total) / 2
		b.Position = UDim2.fromOffset(x0 + col * (bw + gap), margin + row * (bh + gap))
		b.Size = UDim2.fromOffset(bw, bh)
	end
end

