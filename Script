local function new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		inst[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function approach(cur, target, up, down)
	if target > cur then
		return math.min(cur + up, target)
	end
	return math.max(cur - down, target)
end

local function wrapAngle(a)
	return (a + math.pi) % (math.pi * 2) - math.pi
end

local TORQUE_CURVE = {
	{ 1000, 0.60 }, { 2000, 0.82 }, { 3000, 0.95 }, { 4000, 1.00 },
	{ 5000, 0.99 }, { 6000, 0.92 }, { 7000, 0.78 }, { 7600, 0.60 },
}

local function torqueFactor(rpm)
	local c = TORQUE_CURVE
	if rpm <= c[1][1] then
		return c[1][2]
	end
	for i = 2, #c do
		if rpm <= c[i][1] then
			local a, b = c[i - 1], c[i]
			return a[2] + (b[2] - a[2]) * (rpm - a[1]) / (b[1] - a[1])
		end
	end
	return c[#c][2]
end

