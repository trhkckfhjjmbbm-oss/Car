local function stepCar(dtRaw)
	local car = CAR
	if not car or not car.chassis.Parent then
		return
	end
	local dt = math.clamp(dtRaw, 1 / 240, 1 / 30)
	local chassis = car.chassis
	local cf = chassis.CFrame
	local up, fwd = cf.UpVector, cf.LookVector
	local vel = chassis.AssemblyLinearVelocity
	local mass = chassis.AssemblyMass
	local g = Workspace.Gravity
	local vf = vel:Dot(fwd)
	local speed = vel.Magnitude
	local R = CFG.WHEEL_RADIUS
	local wheels = car.wheels

	-- Педали газа и тормоза, выбор D / R
	local inp = S.driving and readInput() or NO_INPUT
	local hand = inp.hand
	local gasTarget, brakeTarget
	if not S.reverse then
		gasTarget, brakeTarget = inp.fwd, inp.back
		if inp.back > 0.2 and inp.fwd < 0.1 and vf < 1.5 then
			S.reverseTimer += dt
			if S.reverseTimer > 0.25 then
				S.reverse = true
				S.reverseTimer = 0
				S.shiftTimer = CFG.SHIFT_TIME
			end
		else
			S.reverseTimer = 0
		end
	else
		gasTarget, brakeTarget = inp.back, inp.fwd
		if inp.fwd > 0.2 and inp.back < 0.1 and vf > -1.5 then
			S.reverseTimer += dt
			if S.reverseTimer > 0.25 then
				S.reverse = false
				S.reverseTimer = 0
				S.gear = 1
				S.shiftTimer = CFG.SHIFT_TIME
			end
		else
			S.reverseTimer = 0
		end
	end
	if not S.driving then
		-- стоянка: ручник и лёгкий тормоз
		gasTarget, brakeTarget, hand = 0, 0.6, true
	end
	S.handbrakeOn = hand
	S.throttle = approach(S.throttle, gasTarget, dt * 5, dt * 9)
	S.brake = approach(S.brake, brakeTarget, dt * 9, dt * 12)

	-- Руль: чем быстрее, тем меньше угол
	local steerFactor = math.clamp(math.abs(vf) / CFG.STEER_FADE_SPEED, 0, 1)
	local maxSteer = math.rad(CFG.STEER_MAX_LOW + (CFG.STEER_MAX_HIGH - CFG.STEER_MAX_LOW) * steerFactor)
	local steerTarget = inp.steer * maxSteer
	local steerRate = (math.abs(steerTarget) > math.abs(S.steer)) and CFG.STEER_RATE_IN or CFG.STEER_RATE_OUT
	S.steer = approach(S.steer, steerTarget, dt * steerRate, dt * steerRate)

	-- Автоматическая коробка передач
	local nDriven, wSum = 0, 0
	for _, wh in ipairs(wheels) do
		if wh.driven then
			nDriven += 1
			wSum += wh.w
		end
	end
	local wDrive = wSum / math.max(nDriven, 1)
	local gearsN = #CFG.GEARS
	local function ratioNow()
		return (S.reverse and CFG.REVERSE_RATIO or CFG.GEARS[S.gear]) * CFG.FINAL_DRIVE
	end
	local gearRatio = ratioNow()
	local rpmWheels = math.abs(wDrive) * gearRatio * 9.5493

	S.shiftTimer = math.max(0, S.shiftTimer - dt)
	S.shiftCooldown = math.max(0, S.shiftCooldown - dt)
	if not S.reverse and S.shiftCooldown <= 0 and S.shiftTimer <= 0 then
		local th = S.throttle
		local upRpm = CFG.UPSHIFT_RPM[1] + (CFG.UPSHIFT_RPM[2] - CFG.UPSHIFT_RPM[1]) * th
		local downRpm = CFG.DOWNSHIFT_RPM[1] + (CFG.DOWNSHIFT_RPM[2] - CFG.DOWNSHIFT_RPM[1]) * th
		if rpmWheels > upRpm and S.gear < gearsN then
			S.gear += 1
			S.shiftTimer = CFG.SHIFT_TIME
			S.shiftCooldown = 0.5
		elseif rpmWheels < downRpm and S.gear > 1 then
			S.gear -= 1
			S.shiftTimer = CFG.SHIFT_TIME * 0.6
			S.shiftCooldown = 0.3
		end
		gearRatio = ratioNow()
	end

	-- Двигатель: обороты, сцепление, ограничитель
	local launch = CFG.IDLE_RPM + (CFG.LAUNCH_RPM - CFG.IDLE_RPM) * S.throttle
	local rpm = math.max(rpmWheels, launch)
	local clutch = math.clamp(rpmWheels / CFG.CLUTCH_FULL_RPM, CFG.CLUTCH_MIN, 1)
	local limiter = rpm >= CFG.REDLINE_RPM
	rpm = math.min(rpm, CFG.REDLINE_RPM + 200)
	S.rpm += (rpm - S.rpm) * math.min(1, dt * 14)

	-- Противобуксовочная система: режет газ, пока колёса пробуксовывают
	local dirSign = S.reverse and -1 or 1
	local tcsTarget = 1
	S.tcsActive = false
	if S.tcsEnabled and S.driving and not hand and S.throttle > 0.05 then
		local worst = 0
		for _, wh in ipairs(wheels) do
			if wh.driven and wh.contact then
				local m = math.max(wh.slip * dirSign, 0) / math.max(math.abs(wh.vx), 5)
				worst = math.max(worst, m)
			end
		end
		if worst > CFG.TCS_THRESHOLD then
			tcsTarget = math.clamp(1 - (worst - CFG.TCS_THRESHOLD) * CFG.TCS_GAIN, 0.05, 1)
			S.tcsActive = true
		end
	end
	S.tcsFactor = approach(S.tcsFactor, tcsTarget, dt * 3, dt * 25)

	-- Крутящий момент и торможение двигателем
	local peakTorque = CFG.ACCEL_FIRST_GEAR * mass * R / (CFG.GEARS[1] * CFG.FINAL_DRIVE * CFG.DRIVETRAIN_EFF)
	local driveTorque, engBrake = 0, 0
	if S.shiftTimer <= 0 then
		if not limiter and not (S.reverse and -vf > CFG.REVERSE_MAX_SPEED) then
			driveTorque = peakTorque * torqueFactor(rpm) * S.throttle * S.tcsFactor * clutch * dirSign
		end
		local roll = math.clamp(wDrive * R / 3, -1, 1)
		local rpmK = 0.25 + 0.75 * math.min(rpm / CFG.REDLINE_RPM, 1)
		engBrake = peakTorque * CFG.ENGINE_BRAKE * (1 - S.throttle) * rpmK * roll * math.max(clutch, 0.6)
	end
	local wheelTorque = (driveTorque - engBrake) * gearRatio * CFG.DRIVETRAIN_EFF
	local driveForceEach = wheelTorque / math.max(nDriven, 1) / R

	-- Подвеска и шины на каждом колесе
	local Mw = mass / 4
	local omega2 = g / CFG.SUSP_STATIC_COMPRESSION
	local K = Mw * omega2
	local C = Mw * 2 * CFG.SUSP_DAMPING_RATIO * math.sqrt(omega2)
	local Lmin = CFG.SUSP_REST - CFG.SUSP_BUMP
	local Lmax = CFG.SUSP_REST + CFG.SUSP_DROOP
	local totalBrake = CFG.BRAKE_FORCE * mass * g
	local anyContact = false

	for _, wh in ipairs(wheels) do
		local mountWorld = cf:PointToWorldSpace(Vector3.new(wh.x, CFG.MOUNT_Y, wh.z))
		local res = Workspace:Raycast(mountWorld, -up * (Lmax + R), rayParams)
		local steerAngle = wh.front and S.steer or 0
		local slipping = false

		if res then
			anyContact = true
			wh.contact = true

			-- пружина + демпфер (нормальная сила)
			local L = math.clamp(res.Distance - R, 0.05, Lmax)
			local vMount = chassis:GetVelocityAtPosition(mountWorld)
			local N = K * (CFG.SUSP_REST - L) - C * vMount:Dot(up)
			if L < Lmin then
				N += K * 6 * (Lmin - L) -- ограничитель хода сжатия
			end
			N = math.clamp(N, 0, Mw * g * 6)
			wh.N = N
			wh.visTarget = L

			-- оси колеса в плоскости земли (с учётом поворота руля)
			local wc = mountWorld - up * L
			local n = res.Normal
			local wf = CFrame.fromAxisAngle(up, -steerAngle):VectorToWorldSpace(fwd)
			wf = wf - n * wf:Dot(n)
			if wf.Magnitude < 1e-3 then
				wf = fwd
			end
			wf = wf.Unit
			local wr = wf:Cross(n).Unit

			local vp = chassis:GetVelocityAtPosition(wc)
			local vx, vy = vp:Dot(wf), vp:Dot(wr)
			wh.vx = vx

			local mu = CFG.TIRE_GRIP * (SURFACE_GRIP[res.Material] or 1) * (wh.front and 1 or CFG.REAR_GRIP_BIAS)
			local Fmax = mu * N

			-- продольная команда: тяга и тормоза (ABS не даёт заблокировать колесо)
			local driveF = wh.driven and driveForceEach or 0
			local brakeShare = wh.front and CFG.BRAKE_FRONT_BIAS or (1 - CFG.BRAKE_FRONT_BIAS)
			local brakeMax = totalBrake * brakeShare * 0.5 * S.brake
			local rearHand = hand and not wh.front
			if rearHand then
				brakeMax += CFG.HANDBRAKE_FORCE * mass * g * 0.5
			elseif CFG.ABS and brakeMax > Fmax * 0.88 then
				brakeMax = Fmax * 0.88
				S.absTimer = 0.2
			end
			brakeMax += CFG.ROLLING_RESISTANCE * N -- сопротивление качению
			local brakeMag = math.min(brakeMax, Mw * 0.9 * math.abs(vx) / dt)
			local FxCmd = driveF - math.sign(vx) * brakeMag
			local FyCmd = -vy * Mw * CFG.LATERAL_GAIN / dt

			-- круг трения с мягким переходом к пределу сцепления
			local Fx, Fy = FxCmd, FyCmd
			local mag = math.sqrt(FxCmd * FxCmd + FyCmd * FyCmd)
			local knee = Fmax * 0.65
			if mag > knee and mag > 1e-4 then
				local range = math.max(Fmax - knee, 1e-4)
				local sc = (knee + range * math.tanh((mag - knee) / range)) / mag
				Fx *= sc
				Fy *= sc
			end

			-- пробуксовка: часть команды, которую шина не передала
			local slipTarget = (FxCmd - Fx) / math.max(Mw, 1e-3) * CFG.SLIP_GAIN
			wh.slip += (slipTarget - wh.slip) * math.min(1, dt * 12)
			local surface = vx + wh.slip
			if rearHand then
				surface = 0
			end
			wh.w = surface / R

			chassis:ApplyImpulseAtPosition((wf * Fx + wr * Fy + up * N) * dt, wc)
			slipping = math.abs(wh.slip) > 4 or math.abs(vy) > 9 or (rearHand and speed > 15)
		else
			-- колесо в воздухе
			wh.contact = false
			wh.N = 0
			wh.visTarget = Lmax
			wh.vx = 0
			local driveF = wh.driven and driveForceEach or 0
			wh.w += driveF / (Mw * 0.12 * R) * dt
			if S.brake > 0.2 or hand then
				wh.w *= 1 - math.min(1, dt * 6)
			end
			wh.w *= 1 - dt * 0.2
			local wMax = (CFG.REDLINE_RPM / 9.5493) / math.max(gearRatio, 0.1) * 1.1
			wh.w = math.clamp(wh.w, -wMax, wMax)
		end

		-- визуал колеса: ход подвески, руль, вращение
		wh.visL += (wh.visTarget - wh.visL) * math.min(1, dt * 30)
		wh.spin = (wh.spin + wh.w * dt) % (math.pi * 2)
		wh.hubWeld.C0 = CFrame.new(wh.x, CFG.MOUNT_Y - wh.visL, wh.z)
			* CFrame.Angles(0, -steerAngle, 0)
			* CFrame.Angles(-wh.spin, 0, 0)
		if wh.smoke then
			wh.smoke.Rate = slipping and 45 or 0
		end
	end

	-- Сопротивление воздуха и прижимная сила
	local hv = Vector3.new(vel.X, 0, vel.Z)
	local hs = hv.Magnitude
	if hs > 0.5 then
		chassis:ApplyImpulse(-hv * (hs * CFG.DRAG * mass * dt))
	end
	if anyContact then
		chassis:ApplyImpulse(-up * (CFG.DOWNFORCE * mass * hs * hs * dt))
	end

	S.absTimer = math.max(0, S.absTimer - dt)
	S.absActive = S.absTimer > 0
	S.speedKmh = speed * 0.28 * 3.6

	car.steerWeld.C0 = car.steerBase * CFrame.Angles(0, 0, -S.steer * 5.6)
	for _, e in ipairs(car.exhaustSmoke) do
		e.Rate = S.driving and (5 + 40 * S.throttle) or 0
	end
	updateLights()
end

---------------------------------------------------------------------------
-- РУКИ НА РУЛЕ
-- Двухзвенная обратная кинематика по Motor6D: руки держат обод руля
-- и поворачиваются вместе с ним.
---------------------------------------------------------------------------
local function findMotor(ch, name)
	for _, d in ipairs(ch:GetDescendants()) do
		if d:IsA("Motor6D") and d.Name == name then
			return d
		end
	end
	return nil
end

local function collectArms(ch, hum)
	local arms = {}
	if hum.RigType == Enum.HumanoidRigType.R15 then
		for _, side in ipairs({ "Left", "Right" }) do
			local shoulder = findMotor(ch, side .. "Shoulder")
			local elbow = findMotor(ch, side .. "Elbow")
			local wrist = findMotor(ch, side .. "Wrist")
			if shoulder and elbow and wrist and shoulder.Part0 then
				table.insert(arms, {
					side = side,
					shoulder = shoulder,
					elbow = elbow,
					wrist = wrist,
					torso = shoulder.Part0,
					pole = Vector3.new(side == "Left" and -0.45 or 0.45, -1, 0.5),
					v1 = elbow.C0.Position - shoulder.C1.Position,
					v2 = wrist.C0.Position - elbow.C1.Position,
				})
			end
		end
	else
		for _, side in ipairs({ "Left", "Right" }) do
			local shoulder = findMotor(ch, side .. " Shoulder")
			if shoulder and shoulder.Part0 and shoulder.Part1 then
				table.insert(arms, {
					side = side,
					shoulder = shoulder,
					torso = shoulder.Part0,
					v1 = Vector3.new(0, -shoulder.Part1.Size.Y / 2, 0) - shoulder.C1.Position,
				})
			end
		end
	end
	return arms
end

-- Поворот, переводящий направление a в направление b
local function rotBetween(a, b)
	a, b = a.Unit, b.Unit
	local d = math.clamp(a:Dot(b), -1, 1)
	if d > 0.99999 then
		return CFrame.new()
	end
	local axis = a:Cross(b)
	if axis.Magnitude < 1e-4 then
		axis = a:Cross(Vector3.xAxis)
		if axis.Magnitude < 1e-3 then
			axis = a:Cross(Vector3.yAxis)
		end
	end
	return CFrame.fromAxisAngle(axis.Unit, math.acos(d))
end

local function rotOnly(cf)
	return cf - cf.Position
end

local function updateArms()
	if not S.driving or not S.arms or #S.arms == 0 or not CAR then
		return
	end
	local car = CAR
	local chassisCF = car.chassis.CFrame
	local wheelRot = -S.steer * 5.6 -- на сколько повёрнут руль

	for _, arm in ipairs(S.arms) do
		-- точка хвата на ободе: левая рука слева (9 часов), правая справа (3 часа)
		local a = (arm.side == "Left" and math.pi or 0) + wheelRot
		local target = (car.steerBase * CFrame.new(0.9 * math.cos(a), 0.9 * math.sin(a), 0.2)).Position

		-- всё считаем в системе координат шасси, чтобы не отставать от машины
		local torsoCF = chassisCF:ToObjectSpace(arm.torso.CFrame)
		local pj = torsoCF * arm.shoulder.C0
		local s0 = pj.Position
		local pjRot = rotOnly(pj)
		local c1Rot = rotOnly(arm.shoulder.C1)
		local o0 = pjRot * c1Rot:Inverse()

		if arm.elbow then
			local L1, L2 = arm.v1.Magnitude, arm.v2.Magnitude
			local toT = target - s0
			local dist = math.clamp(toT.Magnitude, math.abs(L1 - L2) + 0.05, L1 + L2 - 0.02)
			local u = toT.Unit
			local aLen = (L1 * L1 - L2 * L2 + dist * dist) / (2 * dist)
			local h = math.sqrt(math.max(L1 * L1 - aLen * aLen, 0))
			local pPerp = arm.pole - u * arm.pole:Dot(u)
			pPerp = pPerp.Magnitude > 1e-3 and pPerp.Unit or Vector3.new(0, -1, 0)
			local elbowPos = s0 + u * aLen + pPerp * h
			local wristPos = s0 + u * dist

			-- плечо
			local o1 = rotBetween(o0:VectorToWorldSpace(arm.v1), elbowPos - s0) * o0
			local rm1 = pjRot:Inverse() * o1 * c1Rot
			arm.shoulder.Transform = rm1

			-- предплечье
			local upperCF = pj * rm1 * arm.shoulder.C1:Inverse()
			local pj2 = upperCF * arm.elbow.C0
			local pj2Rot = rotOnly(pj2)
			local c1Rot2 = rotOnly(arm.elbow.C1)
			local o2n = pj2Rot * c1Rot2:Inverse()
			local o2 = rotBetween(o2n:VectorToWorldSpace(arm.v2), wristPos - elbowPos) * o2n
			arm.elbow.Transform = pj2Rot:Inverse() * o2 * c1Rot2
			arm.wrist.Transform = CFrame.new()
		else
			-- R6: одна кость, просто тянем руку к рулю
			local o1 = rotBetween(o0:VectorToWorldSpace(arm.v1), target - s0) * o0
			arm.shoulder.Transform = pjRot:Inverse() * o1 * c1Rot
		end
	end
end

---------------------------------------------------------------------------
-- КАМЕРА: снаружи (крутится пальцем / мышью) и от первого лица
---------------------------------------------------------------------------
local function setHeadHidden(hide)
	local ch = S.character
	if not ch or not ch.Parent then
		return
	end
	for _, d in ipairs(ch:GetDescendants()) do
		if d:IsA("BasePart") and (d.Name == "Head" or (d.Parent and d.Parent:IsA("Accoutrement"))) then
			d.LocalTransparencyModifier = hide and 1 or 0
		end
	end
end

local function applyCameraMode()
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	if S.driving then
		cam.CameraType = Enum.CameraType.Scriptable
	else
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = 70
		if S.humanoid and S.humanoid.Parent then
			cam.CameraSubject = S.humanoid
		end
	end
	setHeadHidden(S.driving and S.camMode == 2)
end

local function lookInput(dx, dy, sens)
	S.lookYaw = wrapAngle(S.lookYaw - dx * sens)
	S.lookPitch = math.clamp(S.lookPitch - dy * sens, -1.2, 1.0)
	S.lookTime = os.clock()
end

local function updateCamera(dt)
	if not S.driving or not CAR or not CAR.chassis.Parent then
		return
	end
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	if cam.CameraType ~= Enum.CameraType.Scriptable then
		cam.CameraType = Enum.CameraType.Scriptable
	end

	-- если экран не трогают, камера плавно возвращается за машину
	if not (dragTouch or dragMouse) and os.clock() - S.lookTime > CFG.CAM_RECENTER_DELAY then
		local k = 1 - math.exp(-dt * 2.2)
		S.lookYaw = S.lookYaw * (1 - k)
		S.lookPitch = S.lookPitch * (1 - k)
	end

	local chassis = CAR.chassis
	local cf = chassis.CFrame
	local speed = chassis.AssemblyLinearVelocity.Magnitude

	if S.camMode == 2 then
		-- от первого лица: камера в глазах водителя, голова крутится пальцем / мышью
		local eye = cf * CFrame.new(S.eyeLocal)
		local yaw = math.clamp(S.lookYaw, -2.2, 2.2)
		local pitch = math.clamp(S.lookPitch, -1.0, 0.9)
		cam.CFrame = eye * CFrame.fromOrientation(pitch, yaw, 0)
		cam.FieldOfView = 78 + math.clamp(speed / 140, 0, 1) * 10
		return
	end

	-- снаружи: камера за машиной, можно облететь вокруг
	local look = cf.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude > 0.05 then
		flat = flat.Unit
		camDir = camDir:Lerp(flat, 1 - math.exp(-dt * 4.5))
		if camDir.Magnitude < 0.05 then
			camDir = flat
		end
		camDir = camDir.Unit
	end
	local dir = CFrame.Angles(0, S.lookYaw, 0):VectorToWorldSpace(camDir)
	local focus = cf.Position + Vector3.new(0, 2.8, 0)
	local dist = (16 + math.clamp(speed / 80, 0, 1) * 5) * S.zoom
	local elev = math.clamp(math.rad(18) - S.lookPitch, math.rad(-8), math.rad(78))
	local pos = focus - dir * (dist * math.cos(elev)) + Vector3.new(0, dist * math.sin(elev), 0)

	camRayParams.FilterDescendantsInstances = { CAR.model, S.character }
	local hit = Workspace:Raycast(focus, pos - focus, camRayParams)
	if hit then
		pos = hit.Position + (focus - pos).Unit * 0.7
	end

	cam.CFrame = CFrame.lookAt(pos, focus + dir * 5)
	cam.FieldOfView = 70 + math.clamp(speed / 140, 0, 1) * 14
end

