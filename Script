local function keyAxis(a, b)
	return (UserInputService:IsKeyDown(a) or UserInputService:IsKeyDown(b)) and 1 or 0
end

local function readInput()
	local fwd = keyAxis(Enum.KeyCode.W, Enum.KeyCode.Up)
	local back = keyAxis(Enum.KeyCode.S, Enum.KeyCode.Down)
	local steer = keyAxis(Enum.KeyCode.D, Enum.KeyCode.Right) - keyAxis(Enum.KeyCode.A, Enum.KeyCode.Left)
	local hand = UserInputService:IsKeyDown(Enum.KeyCode.Space) or S.touchHand

	-- стандартные контроллеры Roblox: стик телефона и геймпада
	if controls then
		local ok, mv = pcall(function()
			return controls:GetMoveVector()
		end)
		if ok and mv then
			fwd = math.max(fwd, math.clamp(-mv.Z, 0, 1))
			back = math.max(back, math.clamp(mv.Z, 0, 1))
			steer = math.clamp(steer + mv.X, -1, 1)
		end
	end

	if UserInputService.GamepadEnabled then
		for _, obj in ipairs(UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1)) do
			if obj.KeyCode == Enum.KeyCode.ButtonR2 then
				fwd = math.max(fwd, obj.Position.Z)
			elseif obj.KeyCode == Enum.KeyCode.ButtonL2 then
				back = math.max(back, obj.Position.Z)
			end
		end
		if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonX) then
			hand = true
		end
	end

	return { fwd = fwd, back = back, steer = steer, hand = hand }
end

