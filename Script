		end
	end

	local near = false
	if not driving then
		local ch = player.Character
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		if hrp and (hrp.Position - CAR.chassis.Position).Magnitude <= CFG.ENTER_DISTANCE then
			near = true
		end
	end
	H.prompt.Visible = near
	if not driving then
		return
	end

	if H.btnView then
		local viewText = S.camMode == 1 and "1 ЛИЦО" or "3 ЛИЦО"
		if H.btnView.Text ~= viewText then
			H.btnView.Text = viewText
		end
	end

