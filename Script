		table.insert(car.reverseLenses, rev)

		-- выхлопные трубы с дымом
		local exCF = CFrame.new(s * 2.3, -1.0, 9.9) * CFrame.Angles(0, math.rad(90), 0)
		mk("ExhaustTip", Vector3.new(0.9, 0.7, 0.7), exCF, CHROME, Enum.Material.Metal, { cylinder = true, reflectance = 0.3 })
		mk("ExhaustHole", Vector3.new(0.96, 0.5, 0.5), exCF, DARK, nil, { cylinder = true })
		local exEmit = mk("ExhaustEmit", Vector3.new(0.2, 0.2, 0.2), CFrame.new(s * 2.3, -1.0, 10.45), DARK, nil, INVIS)
		table.insert(car.exhaustSmoke, addSmoke(exEmit, Enum.NormalId.Back, false))
	end

	-- Колёса: ступица на Weld (подвеска и руль меняют C0), шина, диск, спицы
	local R, W = CFG.WHEEL_RADIUS, CFG.WHEEL_WIDTH
	local defs = {
		{ name = "FL", x = -CFG.TRACK_HALF, z = aF, front = true, side = -1 },
		{ name = "FR", x = CFG.TRACK_HALF, z = aF, front = true, side = 1 },
		{ name = "RL", x = -CFG.TRACK_HALF, z = aR, front = false, side = -1 },
		{ name = "RR", x = CFG.TRACK_HALF, z = aR, front = false, side = 1 },
	}
	
	for _, d in ipairs(defs) do
		local hub = mk("Hub" .. d.name, Vector3.new(0.4, 0.4, 0.4), CFrame.new(d.x, wheelCY, d.z), TRIM, nil, INVIS)
		local o = d.side -- направление "наружу"
		mk("Tire", Vector3.new(W, 2 * R, 2 * R), CFrame.new(0, 0, 0), TIRE, Enum.Material.SmoothPlastic, { cylinder = true, shadow = false }, hub)
		mk("RimLip", Vector3.new(0.12, 1.48 * R, 1.48 * R), CFrame.new(o * 0.62, 0, 0), CHROME, Enum.Material.Metal, { cylinder = true, reflectance = 0.25, shadow = false }, hub)
		mk("RimDish", Vector3.new(0.1, 1.28 * R, 1.28 * R), CFrame.new(o * 0.66, 0, 0), DARK, nil, { cylinder = true, shadow = false }, hub)
		for k = 0, 4 do
			local a = k * math.pi * 2 / 5
			local cf = CFrame.new(o * 0.7, 0.425 * math.cos(a), 0.425 * math.sin(a)) * CFrame.Angles(a, 0, 0)
			mk("Spoke", Vector3.new(0.1, 0.85, 0.2), cf, CHROME, Enum.Material.Metal, { reflectance = 0.25, shadow = false }, hub)
		end
		mk("Cap", Vector3.new(0.1, 0.43, 0.43), CFrame.new(o * 0.74, 0, 0), CHROME, Enum.Material.Metal, { cylinder = true, shadow = false }, hub)

		local wheel = {
			name = d.name,
			x = d.x,
			z = d.z,
			front = d.front,
			driven = isDriven(d.front),
			hubWeld = hub:FindFirstChildOfClass("Weld"),
			w = 0,
			slip = 0,
			vx = 0,
			spin = 0,
			visL = restL,
			visTarget = restL,
			N = 0,
			contact = false,
		}
		if not d.front then
			local anchor = mk("SmokeAnchor" .. d.name, Vector3.new(0.2, 0.2, 0.2), CFrame.new(d.x, wheelCY - R + 0.3, d.z), DARK, nil, INVIS)
			wheel.smoke = addSmoke(anchor, Enum.NormalId.Top, true)
		end
		table.insert(car.wheels, wheel)
	end

	-- Коллайдер кабины (чтобы крыша не проваливалась при перевороте)
	local cabin = mk("CabinCollider", Vector3.new(7.0, 2.5, 4.9), CFrame.new(0, 2.7, 0.55), DARK, nil, INVIS)
	cabin.CanCollide = true
	cabin.CanQuery = true
	car.cabin = cabin

	model.Parent = Workspace
	return car
end

