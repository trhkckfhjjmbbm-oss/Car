local function updateLights()
	local car = CAR
	if not car then
		return
	end
	local braking = (S.driving and (S.brake > 0.08 or S.handbrakeOn)) and true or false
	local rev = (S.driving and S.reverse) and true or false
	if braking == S.lastBraking and rev == S.lastRev and S.lights == S.lastLights then
		return
	end
	S.lastBraking, S.lastRev, S.lastLights = braking, rev, S.lights

	local headOn = S.lights >= 1
	local high = S.lights == 2
	for _, p in ipairs(car.headLenses) do
		setEmissive(p, headOn, HEAD_ON, HEAD_OFF)
	end
	for _, p in ipairs(car.driveLenses) do
		setEmissive(p, high, HEAD_ON, HEAD_OFF)
	end
	for _, l in ipairs(car.headSpots) do
		l.Enabled = headOn
		l.Angle = high and 55 or 80
		l.Brightness = high and 3.5 or 2.5
	end
	for _, l in ipairs(car.highSpots) do
		l.Enabled = high
	end
	for _, p in ipairs(car.tailLenses) do
		if braking then
			setEmissive(p, true, Color3.fromRGB(255, 25, 25), TAIL_OFF)
		elseif headOn then
			setEmissive(p, true, Color3.fromRGB(150, 8, 8), TAIL_OFF)
		else
			setEmissive(p, false, TAIL_OFF, TAIL_OFF)
		end
	end
	for _, l in ipairs(car.tailLights) do
		l.Enabled = braking or headOn
		l.Brightness = braking and 2 or 0.8
	end
	for _, p in ipairs(car.reverseLenses) do
		setEmissive(p, rev, Color3.new(1, 1, 1), REV_OFF)
	end
end

