local function buildCar(spawnCF)
	local model = Instance.new("Model")
	model.Name = "LocalCar"

	-- Шасси: невидимый коллайдер, единственная деталь с массой.
	local volume = 8.0 * 2.8 * 17.6
	local chassis = Instance.new("Part")
	chassis.Name = "Chassis"
	chassis.Size = Vector3.new(8.0, 2.8, 17.6)
	chassis.Transparency = 1
	chassis.CanCollide = true
	chassis.Anchored = false
	chassis.CastShadow = false
	chassis.TopSurface = Enum.SurfaceType.Smooth
	chassis.BottomSurface = Enum.SurfaceType.Smooth
	chassis.CustomPhysicalProperties = PhysicalProperties.new(CFG.MASS / volume, 0.2, 0, 1, 1)
	pcall(function()
		chassis.RootPriority = 127
	end)
	chassis.CFrame = spawnCF
	chassis.Parent = model
	model.PrimaryPart = chassis

	local car = {
		model = model,
		chassis = chassis,
		wheels = {},
		headLenses = {},
		driveLenses = {},
		headSpots = {},
		highSpots = {},
		tailLenses = {},
		tailLights = {},
		reverseLenses = {},
		exhaustSmoke = {},
	}

	local function weld(part, localCF, base)
		local w = Instance.new("Weld")
		w.Part0 = base or chassis
		w.Part1 = part
		w.C0 = localCF
		w.Parent = part
		return w
	end

	-- Универсальная деталь: все детали кузова massless и сварены Weld'ом.
	local function mk(name, size, localCF, color, material, opts, base)
		opts = opts or {}
		local p = Instance.new("Part")
		p.Name = name
		if opts.cylinder then
			p.Shape = Enum.PartType.Cylinder
		end
		p.Size = size
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.Anchored = false
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Massless = true
		p.CastShadow = opts.shadow ~= false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Transparency = opts.transparency or 0
		p.Reflectance = opts.reflectance or 0
		p.CFrame = (base or chassis).CFrame * localCF
		p.Parent = model
		weld(p, localCF, base)
		return p
	end

	-- Параллелепипед по центру (x, y, z), поворот rx в градусах вокруг X.
	local function box(name, x, y, z, sx, sy, sz, color, material, opts, rx)
		local cf = CFrame.new(x, y, z)
		if rx then
			cf = cf * CFrame.Angles(math.rad(rx), 0, 0)
		end
		return mk(name, Vector3.new(sx, sy, sz), cf, color, material, opts)
	end

	local BODY = CFG.BODY_COLOR
	local TRIM = Color3.fromRGB(24, 24, 28)
	local DARK = Color3.fromRGB(10, 10, 12)
	local GLASS = Color3.fromRGB(120, 160, 185)
	local CHROME = Color3.fromRGB(205, 210, 216)
	local INTERIOR = Color3.fromRGB(48, 48, 54)
	local SEATCOL = Color3.fromRGB(32, 32, 36)
	local TIRE = Color3.fromRGB(20, 20, 22)
	local PLATE = Color3.fromRGB(240, 240, 236)
	local GLASSOPT = { transparency = 0.45, reflectance = 0.1, shadow = false }
	local PAINT = { reflectance = 0.06 }
	local INVIS = { transparency = 1, shadow = false }

	local aF, aR = CFG.AXLE_FRONT, CFG.AXLE_REAR
	local ARCH_R = 1.8
	local restL = CFG.SUSP_REST - CFG.SUSP_STATIC_COMPRESSION
	local wheelCY = CFG.MOUNT_Y - restL -- высота центра колеса в покое

	-- Пол и обвес
	box("Floor", 0, -1.25, 0.2, 7.6, 0.3, 18.2, TRIM)
	box("Splitter", 0, -1.38, -9.8, 8.0, 0.12, 0.9, TRIM)
	box("Diffuser", 0, -1.3, 9.7, 5.0, 0.15, 0.5, DARK)

	-- Нос: наклонная панель, решётка, бампер
	local noseCF = CFrame.new(0, 0.5, -8.85) * CFrame.Angles(math.rad(33), 0, 0)
	mk("Nose", Vector3.new(7.8, 1.6, 0.3), noseCF, BODY, nil, PAINT)
	mk("Grille", Vector3.new(3.4, 0.8, 0.12), noseCF * CFrame.new(0, 0, -0.2), DARK)
	for i = -1, 1 do
		mk("GrilleBar", Vector3.new(3.4, 0.07, 0.06), noseCF * CFrame.new(0, i * 0.22, -0.28), CHROME, Enum.Material.Metal)
	end
	mk("GrilleFrameTop", Vector3.new(3.7, 0.08, 0.1), noseCF * CFrame.new(0, 0.44, -0.25), CHROME, Enum.Material.Metal)
	mk("GrilleFrameBottom", Vector3.new(3.7, 0.08, 0.1), noseCF * CFrame.new(0, -0.44, -0.25), CHROME, Enum.Material.Metal)
	box("BumperFront", 0, -0.75, -9.45, 8.0, 1.3, 0.6, BODY, nil, PAINT)
	box("Intake", 0, -0.85, -9.78, 5.0, 0.6, 0.06, DARK)

	-- Капот, багажник, задняя панель
	box("Hood", 0, 1.3, -6.3, 7.7, 0.3, 5.4, BODY, nil, PAINT, -4)
	box("Trunk", 0, 1.3, 7.0, 7.7, 0.3, 4.6, BODY, nil, PAINT)
	box("RearPanel", 0, -0.025, 9.15, 8.0, 2.35, 0.3, BODY, nil, PAINT)
	box("BumperRear", 0, -0.85, 9.5, 8.0, 1.1, 0.6, BODY, nil, PAINT)

	-- Номерные знаки
	addPlate(box("PlateFront", 0, -0.35, -9.82, 2.4, 0.7, 0.08, PLATE), Enum.NormalId.Front)
	addPlate(box("PlateRear", 0, 0.0, 9.38, 2.4, 0.7, 0.08, PLATE), Enum.NormalId.Back)

	-- Спойлер
	box("Wing", 0, 2.55, 8.6, 7.6, 0.14, 1.5, TRIM, nil, nil, -8)

	-- Салон: стёкла, крыша, кабина
	box("Windshield", 0, 2.725, -2.65, 7.0, 2.9, 0.1, GLASS, Enum.Material.Glass, GLASSOPT, 36)
	box("RearWindow", 0, 2.7, 3.7, 6.8, 3.0, 0.1, GLASS, Enum.Material.Glass, GLASSOPT, -37)
	box("Roof", 0, 4.0, 0.5, 7.0, 0.25, 4.6, BODY, nil, PAINT)
	box("Headliner", 0, 3.85, 0.5, 6.7, 0.08, 4.4, INTERIOR)
	box("CabinFloor", 0, -1.05, 0.2, 7.1, 0.12, 8.0, INTERIOR)
	box("Firewall", 0, 0.1, -3.75, 7.4, 2.4, 0.15, INTERIOR)
	box("Dash", 0, 0.95, -3.0, 7.0, 0.9, 1.4, INTERIOR)
	box("Binnacle", -1.9, 1.55, -2.7, 2.2, 0.5, 0.9, DARK)
	box("Screen", 0.2, 1.7, -2.55, 1.6, 0.9, 0.12, DARK)
	box("Console", 0, -0.45, -0.3, 1.0, 1.3, 4.2, INTERIOR)
	box("Shifter", 0, 0.45, -0.9, 0.25, 0.8, 0.25, TRIM)

	-- Сиденья (поверхность сиденья водителя на y = 0)
	for _, sx in ipairs({ -1.9, 1.9 }) do
		box("SeatBase", sx, -0.85, 0.2, 1.4, 0.5, 1.6, TRIM)
		box("SeatCushion", sx, -0.28, 0.2, 2.2, 0.56, 2.4, SEATCOL)
		box("SeatBack", sx, 1.25, 1.35, 2.2, 2.7, 0.5, SEATCOL, nil, nil, 10)
		box("Headrest", sx, 2.85, 1.65, 1.0, 0.6, 0.4, SEATCOL, nil, nil, 10)
	end
	box("RearSeat", 0, -0.3, 3.0, 6.2, 0.6, 2.0, SEATCOL)
	box("RearSeatBack", 0, 1.0, 3.95, 6.2, 2.3, 0.45, SEATCOL, nil, nil, 12)

	-- Руль: ступица вращается через Weld.C0
	local steerBase = CFrame.new(-1.9, 1.5, -1.7) * CFrame.Angles(math.rad(-24), 0, 0)
	local steerHub = mk("SteerHub", Vector3.new(0.5, 0.5, 0.25), steerBase, TRIM)
	car.steerWeld = steerHub:FindFirstChildOfClass("Weld")
	car.steerBase = steerBase
	for i = 0, 15 do
		local a = i * math.pi / 8
		local cf = CFrame.new(0.85 * math.cos(a), 0.85 * math.sin(a), 0) * CFrame.Angles(0, 0, a + math.pi / 2)
		mk("SteerRing", Vector3.new(0.37, 0.22, 0.22), cf, TRIM, nil, nil, steerHub)
	end
	for _, a in ipairs({ math.pi, 0, -math.pi / 2 }) do
		local cf = CFrame.new(0.425 * math.cos(a), 0.425 * math.sin(a), 0) * CFrame.Angles(0, 0, a - math.pi / 2)
		mk("SteerSpoke", Vector3.new(0.14, 0.85, 0.14), cf, TRIM, nil, nil, steerHub)
	end
	box("SteerColumn", -1.9, 1.05, -2.4, 0.35, 0.35, 1.2, TRIM, nil, nil, -24)

	-- Боковые детали (зеркально для обеих сторон)
	for _, s in ipairs({ -1, 1 }) do
		local sx = s * 3.85

		local function seg(name, z0, z1)
			box(name, sx, -0.125, (z0 + z1) / 2, 0.3, 2.55, z1 - z0, BODY, nil, PAINT)
		end
		-- борта с вырезами под колёса
		seg("SideFront", -9.4, aF - ARCH_R)
		seg("SideMid", aF + ARCH_R, aR - ARCH_R)
		seg("SideRear", aR + ARCH_R, 9.4)
		box("Skirt", s * 4.05, -1.2, (aF + aR) / 2, 0.3, 0.4, (aR - aF) - 2 * ARCH_R, TRIM)
		box("DoorCard", s * 3.62, 0.175, 0, 0.14, 2.55, 7.2, INTERIOR)
		box("Belt", s * 3.7, 1.3, 0.2, 0.6, 0.3, 8.0, BODY, nil, PAINT)

		-- арки: тёмная ниша и расширитель по дуге
		for _, ax in ipairs({ aF, aR }) do
			box("ArchLiner", s * 2.55, -0.125, ax, 0.2, 2.55, ARCH_R * 2, DARK)
			for i = 0, 8 do
				local a = math.rad(10 + i * 20)
				local cf = CFrame.new(s * 4.05, wheelCY + ARCH_R * math.sin(a), ax + ARCH_R * math.cos(a)) * CFrame.Angles(-a, 0, 0)
				mk("ArchFlare", Vector3.new(0.4, 0.72, 0.3), cf, TRIM)
			end
		end

		-- стойки
		box("PillarA", s * 3.55, 2.725, -2.65, 0.4, 2.95, 0.22, BODY, nil, PAINT, 36)
		box("PillarB", s * 3.82, 2.6, 0.55, 0.25, 2.5, 0.45, TRIM)
		box("PillarC", s * 3.5, 2.7, 3.7, 0.5, 3.05, 0.3, BODY, nil, PAINT, -37)
		box("RoofRail", s * 3.6, 3.95, 0.5, 0.4, 0.25, 4.8, BODY, nil, PAINT)

